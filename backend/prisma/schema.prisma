generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Client {
  id         String     @id @default(uuid()) @db.UniqueIdentifier
  nom        String     @db.NVarChar(200)
  telephone  String     @unique @db.NVarChar(30)
  email      String?    @db.NVarChar(255)
  adresse    String     @db.NVarChar(500)
  motDePasse String     @db.NVarChar(255)
  createdAt  DateTime   @default(now()) @db.DateTime2
  updatedAt  DateTime   @updatedAt @db.DateTime2
  commandes  Commande[]
}

model Utilisateur {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  nom        String   @db.NVarChar(200)
  email      String   @unique @db.NVarChar(255)
  motDePasse String   @db.NVarChar(255)
  role       String   @db.NVarChar(20)
  createdAt  DateTime @default(now()) @db.DateTime2
}

model Produit {
  id           String          @id @default(uuid()) @db.UniqueIdentifier
  nom          String          @db.NVarChar(200)
  unite        String          @db.NVarChar(50)
  categorie    String          @default("AUTRE") @db.NVarChar(20)
  prixUnitaire Decimal         @db.Decimal(18, 4)
  disponible   Boolean         @default(true)
  createdAt    DateTime        @default(now()) @db.DateTime2
  updatedAt    DateTime        @updatedAt @db.DateTime2
  lignes       LigneCommande[]
}

model Commande {
  id           String          @id @default(uuid()) @db.UniqueIdentifier
  clientId     String          @db.UniqueIdentifier
  statut       String          @default("EN_ATTENTE") @db.NVarChar(20)
  montantTotal Decimal         @db.Decimal(18, 4)
  dateCommande DateTime        @default(now()) @db.DateTime2
  updatedAt    DateTime        @updatedAt @db.DateTime2
  client       Client          @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes       LigneCommande[]

  @@index([clientId])
  @@index([statut])
}

model LigneCommande {
  id                   String   @id @default(uuid()) @db.UniqueIdentifier
  commandeId           String   @db.UniqueIdentifier
  produitId            String   @db.UniqueIdentifier
  quantite             Decimal  @db.Decimal(18, 4)
  prixUnitaireApplique Decimal  @db.Decimal(18, 4)
  commande             Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produit              Produit  @relation(fields: [produitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([commandeId])
  @@index([produitId])
}
